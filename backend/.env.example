# Neon: use the pooled connection string from the Neon dashboard.
# sslmode=require is added automatically for *.neon.tech URLs if omitted.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000
DATABASE_CONNECT_RETRIES=5
DATABASE_RETRY_DELAY_MS=500
CORS_ORIGIN=http://localhost:5173
